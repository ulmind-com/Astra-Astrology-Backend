# ======================================================================
# Astra Astrology — Backend environment
# Copy to `.env` and fill in the blanks. Never commit `.env`.
# ======================================================================

# ----------------------------------------------------------------- app
APP_NAME="Astra Astrology"
APP_ENV=development                 # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma separated. Add your deployed web + admin URLs before going live.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------- mongodb
# Atlas: mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
# URL-encode the password if it contains @ : / ? # [ ] or %
MONGODB_URI=
MONGODB_DB_NAME=astra_astrology
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=0

# -------------------------------------------------- resend (email/otp)
# https://resend.com/api-keys — the from-domain must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME="Astra Astrology"
SUPPORT_EMAIL=

# --------------------------------------------- cloudinary (media/files)
# https://console.cloudinary.com — Dashboard > API keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=astra-astrology
CLOUDINARY_SECURE=true
MAX_UPLOAD_SIZE_MB=10
