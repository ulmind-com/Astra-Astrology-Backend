# ======================================================================
# Astra Astrology — Backend environment
# Copy to `.env` and fill in the blanks. Never commit `.env`.
# ======================================================================

# ----------------------------------------------------------------- app
APP_NAME="DivinLink"
APP_ENV=development                 # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma separated list of origins, or * to allow every origin.
ALLOWED_ORIGINS=*

# ------------------------------------------------------------- mongodb
# Atlas: mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
# URL-encode the password if it contains @ : / ? # [ ] or %
MONGODB_URI=
MONGODB_DB_NAME=astra_astrology
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=0
MONGODB_CONNECT_TIMEOUT_MS=10000

# -------------------------------------------------------------- health
# Caps how long /health waits on the database, so uptime monitors
# (UptimeRobot, cron-job.org) never time out on it.
HEALTH_DB_TIMEOUT_SECONDS=3.0

# ----------------------------------------------------------------- jwt
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ----------------------------------------------------------------- otp
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# true => the OTP comes back in the API response. LOCAL DEVELOPMENT ONLY. Leave
# it off: the code belongs in the inbox. It is also written to the server log
# whenever it is on, which is the safer way to read it while testing.
OTP_DEV_MODE=false
# How long a sign-up waiting on its OTP is kept.
PENDING_REGISTRATION_EXPIRE_MINUTES=30

# ------------------------------------------------------------ firebase
# Firebase console > Project settings > Service accounts > Generate new private key.
#
# FIREBASE_CREDENTIALS_JSON is the whole service-account JSON on ONE line. This
# is what gets used, and it is the same value you paste into Render — copy the
# line below as-is. Do NOT wrap it in quotes: the private key contains \n
# escapes that must stay literal, and quoting would turn them into real
# newlines and break the parse.
#
# Regenerate it from the key file with:
#   python3 -c "import json,pathlib; print(json.dumps(json.loads(pathlib.Path('secrets/firebase.json').read_text()),separators=(',',':')))"
#
# FIREBASE_CREDENTIALS_PATH is the alternative for local work (a path to the
# downloaded file). It is only read when FIREBASE_CREDENTIALS_JSON is empty.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=
# true => refuse to register anyone while Firebase is unreachable, so MongoDB
# never ends up with a user that has no Firebase twin.
FIREBASE_REQUIRED=true

# --------------------------------------------------- first admin seed
# Used by: uv run python -m scripts.create_admin
FIRST_ADMIN_NAME="Super Admin"
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# -------------------------------------------------- resend (email/otp)
# https://resend.com/api-keys — the from-domain must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME="DivinLink"
SUPPORT_EMAIL=

# --------------------------------------------- cloudinary (media/files)
# https://console.cloudinary.com — Dashboard > API keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=astra-astrology
CLOUDINARY_SECURE=true
MAX_UPLOAD_SIZE_MB=10

# Avatars are resized and compressed by Cloudinary before being stored.
AVATAR_MAX_DIMENSION=512
AVATAR_QUALITY=auto:good
AVATAR_FORMAT=webp

# --------------------------------------------- monitoring (sentry & grafana)
# Sentry: https://sentry.io — Project Settings > Client Keys (DSN)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# Grafana Cloud Loki: https://grafana.com — Cloud Portal > Loki > Send Logs
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_LOKI_TOKEN=
